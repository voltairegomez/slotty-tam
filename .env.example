# Copy to .env for local dev (never commit the real .env — it's git-ignored).
# Get these from your Turso database page (app.turso.tech).

# Your Turso database URL, e.g. libsql://slotty-tam-yourname.aws-us-west-2.turso.io
TURSO_DATABASE_URL=

# A Turso auth token with Read & Write permission.
TURSO_AUTH_TOKEN=

# Optional: for local dev without Turso, you can instead use a local file DB:
# TURSO_DATABASE_URL=file:./dev.db
